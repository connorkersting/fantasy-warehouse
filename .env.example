# Both optional; the defaults are shown in comments. No secrets: the warehouse is a local DuckDB file.
# dbt does not load .env by itself: set these as environment variables in the shell that runs dbt.
# Path to the fantasy-season checkout (default ../fantasy-season)
FANTASY_SEASON_DIR=
# Warehouse file (default fantasy.duckdb in the repo root)
FANTASY_WAREHOUSE_DB=
